# ==============================================================================
# Agente RRHH — variables de entorno (.env.example)
#
# COPIA este archivo como `.env` y completa los valores. `.env` NO se sube a
# git (está en .gitignore). En el deploy Vercel, estas mismas variables se
# configuran en Settings → Environment Variables (nunca van dentro del repo).
# ==============================================================================

# ---- FASE 1 — Ingesta (IMAP Gmail) ------------------------------------------
# EMAIL con App Password de Gmail (https://myaccount.google.com/apppasswords)
EMAIL=
API_EMAIL=
PASSWORD=
# Modelo de extracción F1 (Gemini)
GEMINI_API_KEY=
MODELO_GEMINI=gemini-3.5-flash
# Prefijo del asunto de postulaciones (primera palabra = vacante)
ASUNTO=POSTULACION -
# Ventana de búsqueda en días (1 = hoy; 0 = sin límite de fecha)
DIAS_ATRAS=1
# Retención de archivos raw en bronze (días)
RAWDATA_RETENCION_DIAS=90
# Hora de la ingesta programada
HORA_INGESTA=18:00
IMAP_TIMEOUT=30

# ---- FASE 2 — Evaluación (Groq) ---------------------------------------------
GROQ_API_KEY=
PROVEEDOR_EVALUADOR=groq
MODELO_EVALUADOR=openai/gpt-oss-120b

# ---- FASE 4 — Chatbot (IA opcional) ------------------------------------------
# PROVEEDOR_CHAT vacío/"ninguno" = modo offline (0 llamadas, costo $0).
# En Vercel: `groq` (usa GROQ_API_KEY).
PROVEEDOR_CHAT=
MODELO_CHAT=openai/gpt-oss-120b
# Límite de consultas con IA por conversación (modo demo MVP). Solo aplica si
# PROVEEDOR_CHAT está activo; al agotarse el motor sigue respondiendo con datos
# verificados (0 tokens). Sube el número para dar más consultas gratis.
DEMO_CONSULTAS_IA=3

# ---- Data y prompts ----------------------------------------------------------
# Directorio medallion (bronze/silver/gold). En Vercel usar `data_demo`:
# el repo incluye 30+ candidatos ficticios versionables.
DATA_DIR=data
PROMPT_EXTRACTOR=prompt/extractor.md
PROMPT_EVALUADOR=prompt/evaluador.md
RUTA_VACANTES=config/vacantes
RUTA_TARIFAS=config/tarifas.json