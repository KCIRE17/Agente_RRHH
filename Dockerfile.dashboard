# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Agente RRHH - dashboard F3 (Streamlit).
# Imagen completa (requirements-full.txt) solo para el panel; lee gold/silver
# de DATA_DIR (data_demo por defecto = datos ficticios). Bind 0.0.0.0 para la
# red interna de Docker; el contenedor no queda expuesto fuera del host salvo
# el mapeo de puerto que decida docker-compose.
# ---------------------------------------------------------------------------
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DATA_DIR=data_demo \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

# Dependencias completas (F1-F4), mismas que el arranque local de un clic.
COPY requirements-full.txt ./
RUN pip install --no-cache-dir -r requirements-full.txt

# Codigo de la aplicacion (src/, config/, prompt/, .streamlit/, data_demo/...).
COPY . .

# /app/.streamlit/config.toml aplica el tema del dashboard.
EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=5).status == 200 else 1)"

CMD ["streamlit", "run", "src/agente_rrhh/dashboard/app.py", \
     "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]